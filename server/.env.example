# Backend Service Environment Variables
NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/project_manager_dev
MONGODB_TEST_URI=mongodb://localhost:27017/project_manager_test
REDIS_URL=redis://localhost:6379

CLIENT_URL=http://localhost:5173

ACCESS_TOKEN_SECRET=your_super_secret_access_token_min_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

LOG_LEVEL=info
SLOW_REQUEST_THRESHOLD_MS=500
METRICS_ENABLED=true
METRICS_USER=admin
METRICS_PASS=change_me_in_production

SEARCH_CACHE_TTL=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
TRUST_PROXY=false
STORAGE_DRIVER=local
