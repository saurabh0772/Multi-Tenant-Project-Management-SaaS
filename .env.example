# Application Environment
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/project_manager_dev

# Redis Infrastructure (For future phases)
REDIS_URL=redis://localhost:6379

# Client Application URL (CORS Origin)
CLIENT_URL=http://localhost:5173

# Authentication Secret Placeholders (For future phases)
ACCESS_TOKEN_SECRET=your_development_access_token_secret_min_32_chars
REFRESH_TOKEN_SECRET=your_development_refresh_token_secret_min_32_chars

# Logging
LOG_LEVEL=debug
